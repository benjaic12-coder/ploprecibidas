/*
  Cache-Control: no-store, no-cache, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; object-src 'none'; img-src 'self' data: blob: https://*.supabase.co https://www.facebook.com; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self' https://www.googletagmanager.com https://connect.facebook.net; connect-src 'self' https://*.supabase.co https://www.google-analytics.com https://region1.google-analytics.com https://www.facebook.com https://connect.facebook.net; frame-src blob:; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests;
/assets/*
  ! Cache-Control
  Cache-Control: public,max-age=31536000,immutable
/pedido/*
  X-Robots-Tag: noindex, nofollow
/admin*
  X-Robots-Tag: noindex, nofollow
/baja*
  X-Robots-Tag: noindex, nofollow
